{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>P4suta/renovate-config"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/!(project.rs){,/**}",
    "**/__fixtures__/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/(?:actions\\/ci-policy\\/action|workflows\\/(?:ci-policy-checks|tmpl-verify))\\.yml$/",
        "/^\\.ci\\/verification\\.json$/",
        "/^\\.ci\\/ci-policy\\/(?:tests\\/project\\.rs|src\\/project\\/runtime\\/discovery\\.rs)$/",
        "/^Justfile$/"
      ],
      "matchStrings": [
        "rust@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "--toolchain (?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "rust = [\\\\]\\\"(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "None if backend == \"rust\" => \"(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "rust",
      "datasourceTemplate": "rust-version",
      "versioningTemplate": "rust-release-channel"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/(?:ci-policy-checks|tmpl-verify)\\.yml$/",
        "/^\\.ci\\/verification\\.json$/",
        "/^\\.ci\\/ci-policy\\/src\\/project\\/runtime\\.rs$/"
      ],
      "matchStrings": ["just@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "casey/just",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/tmpl-verify\\.yml$/",
        "/^\\.ci\\/verification\\.json$/",
        "/^\\.ci\\/ci-policy\\/tools\\.json$/"
      ],
      "matchStrings": [
        "typos@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "\"tool\": \"typos\", \"version\": \"(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "crate-ci/typos",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/(?:ci-policy-checks|tmpl-verify)\\.yml$/",
        "/^\\.ci\\/verification\\.json$/",
        "/^\\.ci\\/ci-policy\\/tests\\/project\\.rs$/"
      ],
      "matchStrings": [
        "cargo:(?<depName>[a-z][a-z0-9-]*)@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "(?<depName>cargo-binstall)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "crate"
    }
  ]
}
